# ============================================================
# data_cleaning.ipynb
# Purpose: Clean a retail sales dataset for analysis & BI
# Output: cleaned dataset saved to ../datasets/cleaned_sales_orders.csv
# ============================================================

import os
import pandas as pd
import numpy as np

# 1) Load data
DATA_PATH = os.path.join("..", "datasets", "sample_datasets", "sales_orders.csv")
df = pd.read_csv(DATA_PATH)

df.head()

# 2) Standardize column names (snake_case)
df.columns = (
    df.columns
      .str.strip()
      .str.lower()
      .str.replace(" ", "_")
      .str.replace("-", "_")
)

df.columns

# 3) Convert date columns
for c in ["order_date", "ship_date"]:
    if c in df.columns:
        df[c] = pd.to_datetime(df[c], errors="coerce")

# 4) Basic data type checks
numeric_cols = [c for c in ["sales", "profit", "discount"] if c in df.columns]
for c in numeric_cols:
    df[c] = pd.to_numeric(df[c], errors="coerce")

if "quantity" in df.columns:
    df["quantity"] = pd.to_numeric(df["quantity"], errors="coerce").astype("Int64")

df.dtypes

# 5) Missing values overview
missing = df.isna().mean().sort_values(ascending=False)
missing[missing > 0]

# 6) Remove exact duplicates (full row duplicates)
before = len(df)
df = df.drop_duplicates()
after = len(df)
before, after, before - after

# 7) Handle invalid / negative values (basic rules for a portfolio project)

# Sales should be >= 0
if "sales" in df.columns:
    df = df[df["sales"].notna()]
    df = df[df["sales"] >= 0]

# Quantity should be > 0 (or at least >= 1)
if "quantity" in df.columns:
    df = df[df["quantity"].notna()]
    df = df[df["quantity"] >= 1]

# Discount should be between 0 and 1
if "discount" in df.columns:
    df["discount"] = df["discount"].clip(lower=0, upper=1)

df.describe(include="all").T.head(20)

# 8) Feature engineering useful for BI
if "order_date" in df.columns:
    df["order_year"] = df["order_date"].dt.year
    df["order_month"] = df["order_date"].dt.to_period("M").astype(str)
    df["order_month_start"] = df["order_date"].dt.to_period("M").dt.to_timestamp()

if "order_date" in df.columns and "ship_date" in df.columns:
    df["ship_days"] = (df["ship_date"] - df["order_date"]).dt.days

df[["order_date", "ship_date", "ship_days"]].head()


# 9) Save cleaned output
OUT_PATH = os.path.join("..", "datasets", "cleaned_sales_orders.csv")
df.to_csv(OUT_PATH, index=False)
OUT_PATH, df.shape

