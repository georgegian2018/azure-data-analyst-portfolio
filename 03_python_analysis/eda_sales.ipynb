# ============================================================
# eda_sales.ipynb
# Purpose: Exploratory Data Analysis for Sales Performance
# Input: ../datasets/cleaned_sales_orders.csv
# ============================================================

import os
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

DATA_PATH = os.path.join("..", "datasets", "cleaned_sales_orders.csv")
df = pd.read_csv(DATA_PATH)

# Parse dates if needed
for c in ["order_date", "ship_date", "order_month_start"]:
    if c in df.columns:
        df[c] = pd.to_datetime(df[c], errors="coerce")

df.head()

# 1) High-level KPIs
total_revenue = df["sales"].sum() if "sales" in df.columns else np.nan
total_orders = df["order_id"].nunique() if "order_id" in df.columns else np.nan
total_units = df["quantity"].sum() if "quantity" in df.columns else np.nan
total_profit = df["profit"].sum() if "profit" in df.columns else np.nan
aov = total_revenue / total_orders if total_orders else np.nan

total_revenue, total_orders, total_units, total_profit, aov


# 2) Monthly revenue trend
if "order_month_start" not in df.columns and "order_date" in df.columns:
    df["order_month_start"] = df["order_date"].dt.to_period("M").dt.to_timestamp()

monthly = (df.groupby("order_month_start", dropna=True)["sales"]
             .sum()
             .sort_index())

plt.figure()
plt.plot(monthly.index, monthly.values)
plt.title("Monthly Revenue Trend")
plt.xlabel("Month")
plt.ylabel("Revenue")
plt.xticks(rotation=45)
plt.tight_layout()
plt.show()


# 3) Revenue by region (top)
if "region" in df.columns:
    rev_region = (df.groupby("region")["sales"].sum().sort_values(ascending=False))
    plt.figure()
    plt.bar(rev_region.index.astype(str), rev_region.values)
    plt.title("Revenue by Region")
    plt.xlabel("Region")
    plt.ylabel("Revenue")
    plt.xticks(rotation=30, ha="right")
    plt.tight_layout()
    plt.show()

rev_region.head(10) if "region" in df.columns else None



# 4) Category / sub-category contribution
if "category" in df.columns:
    rev_cat = df.groupby("category")["sales"].sum().sort_values(ascending=False)
    plt.figure()
    plt.bar(rev_cat.index.astype(str), rev_cat.values)
    plt.title("Revenue by Category")
    plt.xlabel("Category")
    plt.ylabel("Revenue")
    plt.xticks(rotation=30, ha="right")
    plt.tight_layout()
    plt.show()

rev_cat if "category" in df.columns else None

# 5) Top 10 products by revenue
if "product_name" in df.columns:
    top_products = (df.groupby("product_name")["sales"]
                      .sum()
                      .sort_values(ascending=False)
                      .head(10))
    plt.figure()
    plt.barh(top_products.index.astype(str)[::-1], top_products.values[::-1])
    plt.title("Top 10 Products by Revenue")
    plt.xlabel("Revenue")
    plt.ylabel("Product")
    plt.tight_layout()
    plt.show()

top_products if "product_name" in df.columns else None


# 6) Simple customer concentration (top customers share)
if "customer_id" in df.columns:
    cust_rev = df.groupby("customer_id")["sales"].sum().sort_values(ascending=False)
    total = cust_rev.sum()
    share_top10 = cust_rev.head(10).sum() / total if total else np.nan
    share_top20 = cust_rev.head(20).sum() / total if total else np.nan

share_top10, share_top20

# 7) Export a small EDA summary table for reporting (optional)
summary = pd.DataFrame({
    "metric": ["total_revenue", "total_orders", "total_units", "total_profit", "avg_order_value"],
    "value": [total_revenue, total_orders, total_units, total_profit, aov]
})
summary

